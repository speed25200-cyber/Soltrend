{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": ["out/", ".next/", "node_modules/"],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.test.ts"],
      "rules": { "no-console": "off" }
    }
  ]
}
